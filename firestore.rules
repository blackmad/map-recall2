rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validMode(mode) {
      return mode == 'pinpoint' || mode == 'guess_name';
    }

    function validRating(rating) {
      return rating == 'again' || rating == 'hard' || rating == 'good' || rating == 'easy';
    }

    function validCategory(category) {
      return category == null || category == 'bug' || category == 'building' || category == 'data' || category == 'request' || category == 'other';
    }

    // The real-world object a note is about. `target` is already the image/card
    // annotation, so the geographic/object reference is stored as `subject`.
    function validSubject(subject) {
      return subject == null || (
        subject is map
        && subject.kind is string
        && (subject.kind == 'pand' || subject.kind == 'model' || subject.kind == 'osm' || subject.kind == 'point')
        && (!('id' in subject) || (subject.id is string && subject.id.size() <= 64))
        && (!('lngLat' in subject) || (subject.lngLat is list && subject.lngLat.size() == 2 && subject.lngLat[0] is number && subject.lngLat[1] is number))
      );
    }

    match /users/{userId}/reviewStates/{stateId} {
      allow read, delete: if owns(userId);
      allow create, update: if owns(userId)
        && request.resource.data.featureKey is string
        && validMode(request.resource.data.mode)
        && request.resource.data.dueAt is number
        && request.resource.data.lastReviewedAt is number
        && request.resource.data.lastEventId is string
        && request.resource.data.schedulerVersion == 1;
    }

    match /users/{userId}/reviewEvents/{eventId} {
      allow read: if owns(userId);
      allow create: if owns(userId)
        && !exists(/databases/$(database)/documents/users/$(userId)/reviewEvents/$(eventId))
        && request.resource.data.id == eventId
        && request.resource.data.featureKey is string
        && validMode(request.resource.data.mode)
        && validRating(request.resource.data.rating)
        && request.resource.data.reviewedAt is number;
      // Retrying an already-committed batch is harmless, but event contents are immutable.
      allow update: if owns(userId) && request.resource.data == resource.data;
      allow delete: if false;
    }

    function validLngLat(point) {
      return point is list && point.size() == 2 && point[0] is number && point[1] is number
        && point[0] >= -180 && point[0] <= 180 && point[1] >= -90 && point[1] <= 90;
    }

    function shortText(value) {
      return value is string && value.size() > 0 && value.size() <= 200;
    }

    function wholeCount(value) {
      return value is int && value >= 0 && value <= 100000;
    }

    // One finished Canal Recall ride (src/canalRecall/routeHistory.ts RideRecord).
    function validRide(ride, sessionId) {
      return ride.keys().hasAll(['id', 'schemaVersion', 'startedAt', 'endedAt', 'mode', 'cityId', 'start', 'finish', 'namedCount', 'askedCount', 'points', 'streetsLearned', 'raceHash'])
        && ride.keys().hasOnly(['id', 'schemaVersion', 'startedAt', 'endedAt', 'mode', 'cityId', 'start', 'finish', 'namedCount', 'askedCount', 'points', 'streetsLearned', 'raceHash'])
        && ride.id == sessionId && sessionId.size() <= 64
        && ride.schemaVersion == 1
        && ride.startedAt is number && ride.endedAt is number && ride.startedAt <= ride.endedAt
        && (ride.mode == 'boat' || ride.mode == 'bike' || ride.mode == 'transit')
        && shortText(ride.cityId)
        && ride.start is map && ride.start.keys().hasOnly(['name', 'lngLat'])
        && shortText(ride.start.name) && validLngLat(ride.start.lngLat)
        && ride.finish is map && ride.finish.keys().hasOnly(['name', 'landmarkId', 'lngLat'])
        && shortText(ride.finish.name) && validLngLat(ride.finish.lngLat)
        && (ride.finish.landmarkId == null || shortText(ride.finish.landmarkId))
        && wholeCount(ride.namedCount) && wholeCount(ride.askedCount) && ride.namedCount <= ride.askedCount
        && ride.points is number && ride.points >= 0 && ride.points <= 10000000
        && ride.streetsLearned is list && ride.streetsLearned.size() <= 100
        && ride.raceHash is string && ride.raceHash.size() <= 200;
    }

    match /users/{userId}/gameSessions/{sessionId} {
      allow read, delete: if owns(userId);
      allow create, update: if owns(userId) && validRide(request.resource.data, sessionId);
    }

    // Browser feedback is private to its author. Queue workers use IAM via the
    // CLI, so browsers cannot claim/resolve tasks or rewrite submitted evidence.
    match /canalFeedback/{noteId} {
      allow get: if request.auth != null && (!exists(/databases/$(database)/documents/canalFeedback/$(noteId)) || resource.data.ownerUid == request.auth.uid);
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasAll(['schemaVersion', 'ownerUid', 'text', 'target', 'context', 'environment', 'screenshot', 'status', 'createdAt', 'updatedAt', 'resolution'])
        && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'text', 'target', 'context', 'environment', 'screenshot', 'status', 'createdAt', 'updatedAt', 'resolution', 'category', 'subject'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 12000
        && request.resource.data.target is map
        && request.resource.data.target.id is string && request.resource.data.target.id.size() <= 2048
        && request.resource.data.target.label is string && request.resource.data.target.label.size() <= 500
        && request.resource.data.target.imageUrl is string && request.resource.data.target.imageUrl.size() <= 4096
        && (request.resource.data.target.anchor == null ||
          (request.resource.data.target.anchor is map
            && request.resource.data.target.anchor.x is number && request.resource.data.target.anchor.y is number
            && request.resource.data.target.anchor.x >= 0 && request.resource.data.target.anchor.x <= 1
            && request.resource.data.target.anchor.y >= 0 && request.resource.data.target.anchor.y <= 1))
        && request.resource.data.context is map
        && request.resource.data.environment is map
        && request.resource.data.environment.host is string
        && request.resource.data.environment.page is string
        && request.resource.data.screenshot is string && request.resource.data.screenshot.size() <= 240000
        && (!('category' in request.resource.data) || validCategory(request.resource.data.category))
        && (!('subject' in request.resource.data) || validSubject(request.resource.data.subject))
        && request.resource.data.status == 'open' && request.resource.data.resolution == ''
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
