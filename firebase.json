{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "edumap",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.md",
        "server.cjs",
        "server.cjs.map",
        "canal-drive/**",
        "data/signage/**",
        "data/rgb-city-demo/**",
        "data/pointcloud-facades/**",
        "data/facade-model-eval/**",
        "data/elandsgracht/**",
        "data/da-costa-block/**",
        "data/facade-materials/**",
        "data/wall-colour/**",
        "data/wall-materials/**",
        "data/facade-block-demo/**"
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/data/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "canalrecall",
      "public": "dist-canalrecall",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.md",
        "server.cjs",
        "server.cjs.map",
        "data/signage/**",
        "data/rgb-city-demo/**",
        "data/pointcloud-facades/**",
        "data/facade-model-eval/**",
        "data/elandsgracht/**",
        "data/da-costa-block/**",
        "data/facade-materials/**",
        "data/wall-colour/**",
        "data/wall-materials/**",
        "data/facade-block-demo/**"
      ],
      "headers": [
        {
          "source": "/data/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/js/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}
