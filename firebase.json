{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "edumap",
      "public": "dist-edumap",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "regex": "^/(?P<rest>.*)$",
          "destination": "https://rideamsterdam.nl/quiz/:rest",
          "type": 301
        }
      ]
    },
    {
      "target": "canalrecall",
      "public": "dist-canalrecall",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.md",
        "server.cjs",
        "server.cjs.map",
        "data/signage/**",
        "data/rgb-city-demo/**",
        "data/pointcloud-facades/**",
        "data/facade-model-eval/**",
        "data/elandsgracht/**",
        "data/da-costa-block/**",
        "data/facade-materials/**",
        "data/wall-colour/**",
        "data/wall-materials/**",
        "data/facade-block-demo/**"
      ],
      "headers": [
        {
          "source": "/quiz/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/data/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/js/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/manual-ordinary-buildings.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/ordinary-buildings.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/ordinary-buildings-data/catalogue.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/models/model-dates.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/quiz/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/progress",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/ride/",
          "destination": "/ride",
          "type": 301
        },
        {
          "source": "/progress/",
          "destination": "/progress",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/ride",
          "destination": "/ride.html"
        },
        {
          "source": "/explore",
          "destination": "/explore.html"
        },
        {
          "source": "/progress",
          "destination": "/quiz/index.html"
        },
        {
          "source": "/quiz/**",
          "destination": "/quiz/index.html"
        }
      ]
    }
  ]
}
