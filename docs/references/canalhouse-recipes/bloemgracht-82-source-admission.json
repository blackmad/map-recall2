        "principalImage": "/private/tmp/canalhouse-bloemgracht-82-fast-whole-20261007/82-full-neighbor-perspective.jpg",
        "nearImage": "/private/tmp/canalhouse-bloemgracht-82-fast-whole-20261007/82-full-neighbor-perspective.jpg",
