  "boundedRecommendation": {
    "requiredFor": "ARTIS positive-X kiosk and future non-turn callers",
    "operation": "Reverse second/third triangle vertices only where geometric normal Y is negative before computing normals; alternatively emit original ordering when turn=true and reversed ordering when turn=false.",
    "doNot": "Globally reverse Micropia triangles or change roof vertices, eaves/ridge heights, footprint, model scale, suppression, materials or native placement.",
    "expectedResult": "All nondegenerate sloped roof faces upward, identical positions/bounds/silhouette. Re-export affected asset under coordinator ownership and rerun winding measurement."
