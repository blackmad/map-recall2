{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:canal-car": "esbuild src/canalRecall/carRoadGuard.ts --bundle --format=iife --global-name=CanalRecallCar --outfile=public/canal-drive/js/car-road-guard.bundle.js --minify",
    "build:canal-buildings": "esbuild src/canalRecall/buildingStyle.ts --bundle --format=iife --global-name=CanalRecallBuildings --outfile=public/canal-drive/js/building-style.bundle.js --minify",
    "build:canal-streets": "esbuild src/canalRecall/streetOverlayStyle.ts --bundle --format=iife --global-name=CanalRecallStreets --outfile=public/canal-drive/js/street-overlay-style.bundle.js --minify",
    "build:canal-3d": "esbuild public/canal-drive/js/detailed-buildings-source.js --bundle --format=iife --global-name=CanalRecallDetailed3D --outfile=public/canal-drive/js/detailed-buildings.bundle.js --minify",
    "dev": "tsx server.ts",
    "build": "npm run build:canal-car && npm run build:canal-neighborhoods && npm run build:canal-bridges && npm run build:canal-buildings && npm run build:canal-recall-store && npm run canal:firebase-config && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:amsterdam": "tsx scripts/build-amsterdam-extract.ts",
    "enrich:amsterdam": "tsx scripts/enrich-amsterdam-wikimedia.ts",
    "enrich:neighborhoods": "tsx scripts/enrich-amsterdam-neighborhoods.ts",
    "refresh:amsterdam": "bash scripts/refresh-amsterdam-extract.sh",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:srs": "tsx scripts/check-spaced-repetition.ts",
    "test:canal-car": "tsx scripts/check-canal-car.ts",
    "test:reachability": "tsx scripts/check-road-reachability.ts",
    "build:roof-colours": "tsx scripts/build-satellite-roof-colours.ts",
    "build:canal-neighborhoods": "esbuild src/canalRecall/neighborhoodState.ts --bundle --format=iife --global-name=CanalRecallNeighborhood --outfile=public/canal-drive/js/neighborhood-state.bundle.js --minify",
    "test:neighborhoods": "tsx scripts/check-neighborhood-transitions.ts",
    "check:canal": "npm run lint && npm run test:canal-car && npm run test:canal-streets && npm run test:neighborhoods && npm run test:bridge-crossings && npm run test:srs && npm run test:reachability && npm run build-storybook",
    "enrich:english": "tsx scripts/translate-extracts-to-english.ts",
    "test:canal-buildings": "tsx scripts/check-canal-buildings.ts",
    "test:osm-buildings": "tsx scripts/check-osm-building-appearance.ts",
    "test:canal-streets": "tsx scripts/check-canal-street-overlays.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "build:canal-recall-store": "esbuild src/canalRecall/recallStore.ts --bundle --format=iife --global-name=CanalRecallStoreModule --outfile=public/canal-drive/js/recall-store.bundle.js --minify",
    "canal:firebase-config": "tsx scripts/write-canal-firebase-config.ts",
    "enrich:amsterdam-wikipedia": "tsx scripts/enrich-amsterdam-wikipedia-extracts.ts",
    "build:canal-bridges": "esbuild src/canalRecall/bridgeCrossings.ts --bundle --format=iife --global-name=CanalRecallBridges --outfile=public/canal-drive/js/bridge-crossings.bundle.js --minify",
    "test:bridge-crossings": "tsx scripts/check-bridge-crossings.ts",
    "build:bridge-crossings": "tsx scripts/build-bridge-crossings.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.0.4",
    "3d-tiles-renderer": "^0.5.2",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.185.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jpeg-js": "^0.4.4",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
