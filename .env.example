# Optional CARTO basemaps API key for high-volume custom raster/vector tile access
VITE_CARTO_API_KEY=

# Optional Google Maps Embed API key for answer-only inline Street View
VITE_GOOGLE_MAPS_EMBED_API_KEY=

# Google Map Tiles API key for Canal Recall photoreal overview (origin-restricted).
# Write public/canal-drive/google-tiles-config.json with: npm run canal:google-tiles-config
# Rotate in Google Cloud after any exposure; never commit the key or that JSON file.
VITE_GOOGLE_MAP_TILES_API_KEY=

# Optional Firebase configuration for accounts and cross-device review sync
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional Sentry error monitoring (Map Quest React app). See docs/MONITORING.md.
VITE_SENTRY_DSN=
# Deploy SHA, used as the Sentry release. Set automatically in CI.
VITE_RELEASE=

# Optional Firebase App Check (reCAPTCHA v3 site key). See docs/MONITORING.md.
VITE_APPCHECK_SITE_KEY=
# Set to "enterprise" to use ReCaptchaEnterpriseProvider instead of v3.
# Local-only debug token for App Check; only read when Vite is in dev mode.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional GEMINI_API_KEY for future AI extensions
GEMINI_API_KEY=
